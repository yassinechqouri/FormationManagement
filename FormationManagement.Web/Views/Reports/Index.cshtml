@{
    ViewData["Title"] = "Reports";
    Layout = "_AdminLayout";
}

<h1 class="mb-4">Reports</h1>
<p class="text-muted">Export system data for offline analysis or record-keeping.</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-people me-2"></i>Users</h5>
                <p class="card-text text-muted">All registered accounts and their roles.</p>
                <a asp-action="UsersExcel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                <a asp-action="UsersPdf" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-journal-bookmark me-2"></i>Courses</h5>
                <p class="card-text text-muted">Full course catalog with pricing and enrollment counts.</p>
                <a asp-action="CoursesExcel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                <a asp-action="CoursesPdf" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-clipboard-check me-2"></i>Enrollments</h5>
                <p class="card-text text-muted">Every learner enrollment and their progress.</p>
                <a asp-action="EnrollmentsExcel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                <a asp-action="EnrollmentsPdf" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            </div>
        </div>
    </div>
</div>
