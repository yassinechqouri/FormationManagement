@model IReadOnlyList<FormationManagement.Application.DTOs.Category.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Categories</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Category</a>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr><th>Name</th><th>Description</th><th>Courses</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td class="text-muted">@category.Description</td>
                    <td><span class="badge bg-secondary">@category.CourseCount</span></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-muted text-center">No categories yet.</td></tr>
            }
        </tbody>
    </table>
</div>
