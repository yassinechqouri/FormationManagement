@model IReadOnlyList<FormationManagement.Application.DTOs.Module.ModuleDto>
@{
    var course = (FormationManagement.Application.DTOs.Course.CourseDto)ViewBag.Course;
    ViewData["Title"] = $"Content — {course.Title}";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@course.Title</h1>
        <span class="text-muted">Manage the modules and lessons for this course.</span>
    </div>
    <a asp-controller="CourseContent" asp-action="CreateModule" asp-route-courseId="@course.Id" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Module
    </a>
</div>

<div class="accordion" id="modulesAccordion">
    @foreach (var module in Model.OrderBy(m => m.Order))
    {
        <div class="accordion-item mb-2">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module-@module.Id">
                    <span class="badge bg-secondary me-2">#@module.Order</span> @module.Title
                </button>
            </h2>
            <div id="module-@module.Id" class="accordion-collapse collapse" data-bs-parent="#modulesAccordion">
                <div class="accordion-body">
                    <p class="text-muted">@module.Description</p>

                    <div class="d-flex gap-2 mb-3">
                        <a asp-controller="CourseContent" asp-action="EditModule" asp-route-id="@module.Id" class="btn btn-sm btn-outline-secondary">Edit Module</a>
                        <form asp-controller="CourseContent" asp-action="DeleteModule" asp-route-id="@module.Id" asp-route-courseId="@course.Id" method="post" onsubmit="return confirm('Delete this module and all its lessons?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete Module</button>
                        </form>
                        <a asp-controller="CourseContent" asp-action="CreateLesson" asp-route-moduleId="@module.Id" class="btn btn-sm btn-primary">+ Add Lesson</a>
                    </div>

                    <ul class="list-group">
                        @foreach (var lesson in module.Lessons)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@lesson.Title</strong>
                                        <span class="text-muted small">(@lesson.Duration min &middot; @lesson.ExerciseCount exercise(s) &middot; @lesson.QuizCount quiz(zes))</span>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="CourseContent" asp-action="EditLesson" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <form asp-controller="CourseContent" asp-action="DeleteLesson" asp-route-id="@lesson.Id" asp-route-courseId="@course.Id" method="post" onsubmit="return confirm('Delete this lesson?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (!module.Lessons.Any())
                        {
                            <li class="list-group-item text-muted">No lessons yet.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">No modules yet. Click "Add Module" to get started.</p>
    }
</div>
