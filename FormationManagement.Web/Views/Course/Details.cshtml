@model FormationManagement.Web.ViewModels.Course.CourseDetailsViewModel
@{ ViewData["Title"] = Model.Course.Title; }

<div class="row">
    <div class="col-md-8">
        <span class="badge bg-secondary mb-2">@Model.Course.CategoryName</span>
        <span class="badge bg-light text-dark mb-2">@Model.Course.Level</span>
        <h1>@Model.Course.Title</h1>
        <p class="text-muted">by @Model.Course.TrainerName &middot; @Model.Course.Duration min total</p>
        <p>@Model.Course.Description</p>

        <h4 class="mt-4">Course Content</h4>
        <div class="accordion" id="modulesAccordion">
            @foreach (var module in Model.Modules.OrderBy(m => m.Order))
            {
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module-@module.Id">
                            @module.Title
                        </button>
                    </h2>
                    <div id="module-@module.Id" class="accordion-collapse collapse" data-bs-parent="#modulesAccordion">
                        <ul class="list-group list-group-flush">
                            @foreach (var lesson in module.Lessons)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-play-circle me-2"></i>@lesson.Title <span class="text-muted small">(@lesson.Duration min)</span></span>
                                    @if (Model.IsEnrolled)
                                    {
                                        <a asp-controller="Lesson" asp-action="View" asp-route-id="@lesson.Id" asp-route-courseId="@Model.Course.Id" class="btn btn-sm btn-outline-primary">Start</a>
                                    }
                                    else
                                    {
                                        <i class="bi bi-lock text-muted"></i>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <img src="@(string.IsNullOrEmpty(Model.Course.Thumbnail) ? "https://placehold.co/400x220?text=Course" : Model.Course.Thumbnail)" class="card-img-top course-thumb" alt="@Model.Course.Title">
            <div class="card-body">
                <h3>@(Model.Course.Price == 0 ? "Free" : Model.Course.Price.ToString("C"))</h3>

                @if (Model.IsEnrolled)
                {
                    <div class="progress mb-3" style="height: 20px;">
                        <div class="progress-bar" style="width:@Model.Progress%">@Model.Progress%</div>
                    </div>
                    <div class="alert alert-success">You're enrolled in this course.</div>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Enroll" asp-route-courseId="@Model.Course.Id" method="post">
                        <button type="submit" class="btn btn-primary w-100">Enroll Now</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Course", new { id = Model.Course.Id })" class="btn btn-primary w-100">Log in to Enroll</a>
                }
            </div>
        </div>
    </div>
</div>
