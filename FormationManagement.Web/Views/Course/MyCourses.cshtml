@model IReadOnlyList<FormationManagement.Application.DTOs.Enrollment.EnrollmentDto>
@{ ViewData["Title"] = "My Courses"; }

<h1 class="mb-4">My Courses</h1>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var e in Model)
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">@e.CourseTitle</h5>
                    <p class="text-muted small">Enrolled on @e.EnrollmentDate.ToString("yyyy-MM-dd")</p>
                    <div class="progress mb-3" style="height: 18px;">
                        <div class="progress-bar" style="width:@e.Progress%">@e.Progress%</div>
                    </div>
                    <a asp-controller="Course" asp-action="Details" asp-route-id="@e.CourseId" class="btn btn-primary btn-sm">Continue Learning</a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">You haven't enrolled in any course yet. <a asp-controller="Course" asp-action="Index">Browse the catalog</a>.</p>
    }
</div>
