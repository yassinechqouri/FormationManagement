@model FormationManagement.Web.ViewModels.Course.LessonViewModel
@{ ViewData["Title"] = Model.Lesson.Title; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
        <li class="breadcrumb-item active">@Model.Lesson.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-7">
        <h1>@Model.Lesson.Title</h1>

        @if (!string.IsNullOrEmpty(Model.Lesson.VideoUrl))
        {
            <div class="ratio ratio-16x9 mb-3">
                <video controls src="@Model.Lesson.VideoUrl"></video>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Lesson.DocumentUrl))
        {
            <a href="@Model.Lesson.DocumentUrl" target="_blank" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-file-earmark-text"></i> Download lesson document
            </a>
        }

        @if (Model.Exercises.Any())
        {
            <h4 class="mt-4">Exercises</h4>
            @foreach (var exercise in Model.Exercises)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <h6 class="card-title">@exercise.Title</h6>
                        <p class="card-text">@exercise.Description</p>
                    </div>
                </div>
            }
        }

        @if (Model.Quizzes.Any())
        {
            <h4 class="mt-4">Quizzes</h4>
            @foreach (var quiz in Model.Quizzes)
            {
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span>@quiz.Title (@quiz.Questions.Count question(s))</span>
                        <a asp-controller="Lesson" asp-action="TakeQuiz" asp-route-id="@quiz.Id" class="btn btn-sm btn-primary">Take Quiz</a>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-5">
        <div class="avatar-panel">
            <h5><i class="bi bi-robot me-2"></i>AI Trainer</h5>

            @if (Model.AvatarPresentation?.VideoUrl != null)
            {
                <video controls src="@Model.AvatarPresentation.VideoUrl"></video>
            }
            else if (Model.AvatarPresentation?.StreamUrl != null)
            {
                <p class="small text-light">Live streaming avatar session available at the provider's stream endpoint.</p>
            }

            <p class="mt-3" id="avatar-response-text">@(Model.AvatarPresentation?.ResponseText ?? "Loading presentation...")</p>

            @if (Model.AvatarPresentation?.Success == false)
            {
                <div class="alert alert-warning small">Avatar provider error: @Model.AvatarPresentation.ErrorMessage</div>
            }

            <hr class="border-secondary" />

            <form id="ask-avatar-form" data-lesson-id="@Model.Lesson.Id">
                @Html.AntiForgeryToken()
                <label class="form-label small">Ask the AI trainer a question:</label>
                <div class="input-group">
                    <input type="text" id="avatar-question" class="form-control form-control-sm" placeholder="Type your question..." />
                    <button type="submit" class="btn btn-sm btn-primary">Ask</button>
                </div>
            </form>
        </div>
    </div>
</div>
