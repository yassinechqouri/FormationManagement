@model IReadOnlyList<FormationManagement.Application.DTOs.Trainer.TrainerDto>
@{
    ViewData["Title"] = "Manage Trainers";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Trainers</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Trainer</a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var trainer in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="@(string.IsNullOrEmpty(trainer.Photo) ? "https://placehold.co/100x100?text=Photo" : trainer.Photo)" class="rounded-circle mb-2" width="90" height="90" style="object-fit:cover;" alt="@trainer.FullName" />
                    <h5 class="card-title mb-0">@trainer.FullName</h5>
                    <div class="text-muted small">@trainer.Email</div>
                    <p class="mt-2">@trainer.Biography</p>
                    <span class="badge bg-secondary">@trainer.CourseCount course(s)</span>
                </div>
                <div class="card-footer bg-white text-end">
                    <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@trainer.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this trainer?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">No trainers yet.</p>
    }
</div>
