@model FormationManagement.Application.DTOs.Quiz.QuestionUpsertDto
@{ ViewData["Title"] = "Add Question"; }

<h1 class="mb-4">Add Question</h1>

<form method="post" class="col-md-7">
    <input type="hidden" asp-for="QuizId" />
    <input type="hidden" name="courseId" id="courseIdField" value="@Context.Request.Query["courseId"]" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="QuestionText" class="form-label"></label>
        <textarea asp-for="QuestionText" class="form-control" rows="2"></textarea>
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <label class="form-label">Answer options (mark exactly one as correct)</label>
    <div id="answers-container">
        @for (var i = 0; i < Model.Answers.Count; i++)
        {
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="radio" name="CorrectIndex" value="@i" checked="@Model.Answers[i].IsCorrect" onclick="updateCorrectFlags()" />
                </div>
                <input type="text" name="Answers[@i].Text" class="form-control" value="@Model.Answers[i].Text" placeholder="Answer text" required />
                <input type="hidden" name="Answers[@i].IsCorrect" id="isCorrect-@i" value="@Model.Answers[i].IsCorrect.ToString().ToLower()" />
            </div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="addAnswerRow()">+ Add another option</button>

    <div>
        <button type="submit" class="btn btn-primary">Save Question</button>
        <a asp-controller="Courses" asp-action="Content" asp-route-courseId="@Context.Request.Query["courseId"]" class="btn btn-outline-secondary">Back to Course</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let answerCount = @Model.Answers.Count;

        function addAnswerRow() {
            const container = document.getElementById('answers-container');
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `
                <div class="input-group-text">
                    <input type="radio" name="CorrectIndex" value="${answerCount}" onclick="updateCorrectFlags()" />
                </div>
                <input type="text" name="Answers[${answerCount}].Text" class="form-control" placeholder="Answer text" required />
                <input type="hidden" name="Answers[${answerCount}].IsCorrect" id="isCorrect-${answerCount}" value="false" />
            `;
            container.appendChild(div);
            answerCount++;
        }

        function updateCorrectFlags() {
            const radios = document.querySelectorAll('input[name="CorrectIndex"]');
            radios.forEach((radio, idx) => {
                document.getElementById('isCorrect-' + idx).value = radio.checked ? 'true' : 'false';
            });
        }
    </script>
}
