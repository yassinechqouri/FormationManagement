@{ ViewData["Title"] = "Check your email"; }
<div class="text-center">
    <i class="bi bi-envelope-check display-4 text-primary"></i>
    <h2 class="mt-3">Check your email</h2>
    <p>If an account exists for that email address, a password reset link has been sent.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Back to Login</a>
</div>
